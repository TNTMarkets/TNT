# Copy to .env and change what you need

# Postgres: the db container creates these on first start; migrate and `pnpm dev` connect with them
POSTGRES_USER=tnt
# scripts/setup.sh fills this with a random value
POSTGRES_PASSWORD=
POSTGRES_DB=tnt
# Port on this machine; `pnpm dev` connects through it
POSTGRES_PORT=5432

# The app is served at https://localhost:<port>
HTTPS_PORT=8443
