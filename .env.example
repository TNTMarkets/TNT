# Copy to .env and change what you need

# Postgres: the db container creates these on first start; migrate and `pnpm dev` connect with them
POSTGRES_USER=tnt
# scripts/setup.sh fills this with a random value
POSTGRES_PASSWORD=
POSTGRES_DB=tnt
# `pnpm dev` only: the db's port on this machine
POSTGRES_PORT=5432

# Docker only: the app is served at https://localhost:<port>
HTTPS_PORT=8443

# Your own 42 app, see docs/setup.md
INTRA42_CLIENT_ID=
INTRA42_CLIENT_SECRET=

# Signs session cookies; scripts/setup.sh fills this with a random value
BETTER_AUTH_SECRET=
# `pnpm dev` only: where you open the app
BETTER_AUTH_URL=http://localhost:5173
