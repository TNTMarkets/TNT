{
  "name": "@tnt/api",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*",
    "#platform/*": "./src/platform/*",
    "#modules/*": "./src/modules/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "compose:dev": "pnpm -w exec docker compose -f compose.yaml -f compose.dev.yaml",
    "db:up": "pnpm compose:dev up --detach --wait db",
    "db:migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "dev": "pnpm db:up && pnpm db:migrate && node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node src/main.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tnt/api-schemas": "workspace:*",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  }
}
