{
  "name": "@tnt/web",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*",
    "#pages/*": "./src/pages/*",
    "#modules/*": "./src/modules/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc && tsc -p e2e",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:screenshots": "vitest run --project screenshots",
    "test:screenshots:update": "vitest run --project screenshots --update"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tnt/api-schemas": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@playwright/test": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
